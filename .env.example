# Postgres owner role (used by docker-compose, the migration tool, and the gate/seed scripts)
POSTGRES_USER=calvin
POSTGRES_PASSWORD=calvin
POSTGRES_DB=calvin_dev
POSTGRES_PORT=5433
DATABASE_URL=postgres://calvin:calvin@localhost:5433/calvin_dev
TEST_DATABASE_URL=postgres://calvin:calvin@localhost:5433/calvin_test

# Postgres restricted app role (what the running server actually connects as -
# see migrations/*_app_role_grants.sql and scripts/db/setup-app-role.js)
APP_DB_PASSWORD=calvin_app
APP_DATABASE_URL=postgres://calvin_app:calvin_app@localhost:5433/calvin_dev
APP_TEST_DATABASE_URL=postgres://calvin_app:calvin_app@localhost:5433/calvin_test

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Sessions (N11) and set-password/reset links (N9)
SESSION_COOKIE_NAME=calvin_session
SET_PASSWORD_URL_BASE=http://localhost:3000/set-password

# SMTP (email helper - set-password links, N9/N10)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Team SynapsE <synapse@iiml.ac.in>"
