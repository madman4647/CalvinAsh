{
  "name": "calvin",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "test:e2e": "playwright test",
    "lint": "npm run lint -w client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node-pg-migrate up -m migrations -j sql --envPath .env",
    "db:migrate:down": "node-pg-migrate down -m migrations -j sql --envPath .env",
    "db:migrate:create": "node-pg-migrate create -m migrations -j sql",
    "db:migrate:test": "node-pg-migrate up -m migrations -j sql --envPath .env -d TEST_DATABASE_URL",
    "db:migrate:test:down": "node-pg-migrate down -m migrations -j sql --envPath .env -d TEST_DATABASE_URL",
    "db:migrate:test:down:all": "node-pg-migrate down 1000 -m migrations -j sql --envPath .env -d TEST_DATABASE_URL",
    "db:setup-role": "node scripts/db/setup-app-role.js",
    "seed:selection-day": "node scripts/seed/selection-day.js",
    "senate:create-account": "node scripts/ops/create-senate-account.js",
    "gate": "node scripts/gate/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "node-pg-migrate": "^7.6.1",
    "pg": "^8.13.0"
  }
}
